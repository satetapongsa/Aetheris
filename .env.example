# ─────────────────────────────────────────────
#  Aetheris — environment variables
#  Copy to .env.local and fill in the values.
# ─────────────────────────────────────────────

# Neon PostgreSQL connection string (https://console.neon.tech)
# e.g. postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Leave empty to run with a temporary in-memory store (data is lost on restart).
DATABASE_URL=

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Optional overrides
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
